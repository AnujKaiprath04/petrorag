# ==============================================================================
# PetroRAG Environment Configuration Template
# Copy this file to .env and configure for your local/production environment
# NEVER commit real credentials, passwords, or API keys to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=PetroRAG
API_HOST=0.0.0.0
API_PORT=8000

# Base Paths (Defaults to project root subdirectories if omitted)
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
SAMPLE_DATA_DIR=data/sample
GROUND_TRUTH_DIR=data/ground_truth

# Relational Database (PostgreSQL)
# Production format: postgresql+psycopg2://user:password@localhost:5432/petrorag
# Development fallback: sqlite:///./data/petrorag.db
DATABASE_URL=sqlite:///./data/petrorag.db
DB_ECHO=false

# Vector Database (Qdrant)
# For remote Qdrant container: http://localhost:6333
# For local embedded storage (no Docker required): ./data/qdrant_storage
# For in-memory testing: :memory:
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_STORAGE_PATH=./data/qdrant_storage
QDRANT_COLLECTION_NAME=petrorag_knowledge_base

# Embedding Model Configuration
# Supported: BAAI/bge-base-en-v1.5, intfloat/e5-base-v2, sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true

# OCR Configuration
OCR_ENGINE=tesseract
TESSERACT_CMD=tesseract
OCR_CONFIDENCE_THRESHOLD=60.0
OCR_CHAR_DENSITY_THRESHOLD=50.0

# Chunking Configuration
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=64
MIN_CHUNK_LENGTH=30
MAX_CHUNK_LENGTH=2000
